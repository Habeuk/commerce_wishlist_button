{#
/**
 * @file
 * Template for the wishlist block.
 *
 * Available variables:
 * - count: The number of items in the wishlist.
 * - button_icon: icone for wishlist.
 * - wishlist_entity: The wishlist entity.
 * - url: The url to the wishlist page.
 *
 * @ingroup themeable
 */
#}
{% set classes = ['wishlist-button-block', count>0?'add':''] %}
<div{{ attributes.addClass(classes) }}>
  <a class="wishlist-block__link" href="{{ url }}">
    {% if count>0 %}<span class="wishlist-block__icone">{{- button_icon|raw -}}</span>{% endif %}<span class="wishlist-block__count">{{ count }}</span>
  </a>
</div>
